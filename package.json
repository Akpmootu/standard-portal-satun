{
  "name": "standard-portal-google-staging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "preview:ui": "node scripts/preview-ui.js",
    "verify:mou": "node --env-file-if-exists=.env.local scripts/verify-mou.js",
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "test": "node --test",
    "check": "node scripts/check-source.js",
