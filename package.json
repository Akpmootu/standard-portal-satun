{
  "name": "standard-portal-google-staging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preview:ui": "node scripts/preview-ui.js",
    "verify:mou": "node --env-file-if-exists=.env.local scripts/verify-mou.js",
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "mock:thaid": "node --env-file-if-exists=.env.local scripts/mock-thaid.js",
    "test": "node --test",
    "check": "node scripts/check-source.js",
    "setup:local": "node scripts/setup-local.js",
    "auth:owner": "node --env-file-if-exists=.env.local scripts/authorize-owner.js",
    "verify:google": "node --env-file-if-exists=.env.local scripts/verify-google.js"
  },
  "dependencies": {
    "google-auth-library": "11.0.2",
    "jose": "6.2.10"
  },
  "packageManager": "pnpm@11.25.0"
}
