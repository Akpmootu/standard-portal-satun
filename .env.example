# Local staging only. Never paste credentials into chat or commit .env.local.
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
# Exactly 32 random bytes encoded as 64 hex characters. setup:local generates it.
SESSION_KEY_HEX=
# Web application OAuth client for end-user sign-in (openid email profile only).
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Separate desktop OAuth client for the data owner's read-only connection.
GOOGLE_STORAGE_CLIENT_ID=
GOOGLE_STORAGE_CLIENT_SECRET=
GOOGLE_STORAGE_REFRESH_TOKEN=
GOOGLE_OWNER_EMAIL=dh.satun@gmail.com
GOOGLE_APP_SHEET_ID=1dWXmgRRg1yP39OSxl2PmFarlH1xAi1gaKy-rJc4Ve7k
GOOGLE_REFERENCE_SHEET_ID=10UtjMGPnBKeMasgtrwYs3SPbqSu-f_RIhPU2tHYAaJw
GOOGLE_EVIDENCE_FOLDER_ID=1d3PzVAq2dY7dToKVYHMq6IjBRLC7oMOi

# Central Apps Script writer. Enable only after owner setup + staging checks.
MOU_WRITES_ENABLED=0
MOU_WRITER_URL=
MOU_WRITER_SECRET=

# Optional external services. Keep disabled until account budget/destination are confirmed.
AI_ENABLED=0
AI_FREE_CONFIRMED=0
MISTRAL_API_KEY=
TELEGRAM_ENABLED=0
TELEGRAM_DESTINATION_CONFIRMED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_NAME=
TELEGRAM_CHAT_TITLE=
# Calendar date YYYY-MM-DD; leave blank until a current deadline is approved.
ASSESSMENT_DEADLINE=
CRON_SECRET=
